+fn is_list_marker(s: &str) -> bool {
+  let t = s.trim();
+  if t.is_empty() {
+    return false;
+  }
+  t.chars().all(|c| {
+    c.is_ascii_digit() || matches!(c, '一' | '二' | '三' | '四' | '五' | '六' | '七' | '八' | '九' | '十')
+  })
+}
+
+/// Body lines for canvas / DOCX.
+/// Always splits on newlines. For `campuses`, also treats `、` as a line break
+/// (keeping numbering like `1、` attached to the following clause).
+pub fn module_body_lines(body: &str, section: &str) -> Vec<String> {
+  let paragraphs: Vec<&str> = body
+    .split('\n')
+    .map(str::trim)
+    .filter(|s| !s.is_empty())
+    .collect();
+  if section != "campuses" {
+    return paragraphs.into_iter().map(|s| s.to_string()).collect();
+  }
+
+  let mut out = Vec::new();
+  for paragraph in paragraphs {
+    let parts: Vec<&str> = paragraph.split('、').collect();
+    let mut pending_marker = String::new();
+    for (i, part) in parts.iter().enumerate() {
+      let trimmed = part.trim();
+      if is_list_marker(trimmed) && i + 1 < parts.len() && pending_marker.is_empty() {
+        pending_marker = format!("{trimmed}、");
+        continue;
+      }
+      let line = format!("{pending_marker}{part}");
+      pending_marker.clear();
+      let line = line.trim();
+      if !line.is_empty() {
+        out.push(line.to_string());
+      }
+    }
+    if !pending_marker.is_empty() {
+      out.push(pending_marker.trim_end_matches('、').to_string());
+    }
+  }
+  out
+}
