{
  "name": "resume-system",
  "private": true,
  "version": "1.5.1",
  "description": "拼履 — modular resume assembler (content library → template → DOCX)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @resume/web",
    "dev:server": "npm run dev -w @resume/server",
    "build": "npm run build -w @resume/domain -w @resume/shared -w @resume/server -w @resume/web",
    "typecheck": "npm run typecheck -w @resume/domain -w @resume/shared -w @resume/server -w @resume/web",
    "test": "npm run test -w @resume/domain -w @resume/server -w @resume/web",
    "app": "bash scripts/launch-acceptance.sh",
    "desktop:prepare": "bash scripts/prepare-desktop-bundle.sh",
    "app:desktop": "npm run desktop:prepare && npm run dev -w @resume/desktop",
    "app:desktop:build": "npm run desktop:prepare && npm run build -w @resume/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5"
  }
}
