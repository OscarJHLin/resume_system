{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "拼履",
  "version": "0.2.1",
  "identifier": "com.resume.assembler",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:8787",
    "beforeDevCommand": "npm run build -w @resume/web",
    "beforeBuildCommand": "npm run build -w @resume/web"
  },
  "app": {
    "windows": [
      {
        "title": "拼履",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/dist": "web-dist"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
